            "EVENTHOUSE_DATABASE": {
              "value": "@pipeline().parameters.EVENTHOUSE_DATABASE",
              "type": "Expression"
            }
          }
        }
      }
    ],
    "parameters": {
      "EVENTHOUSE_CLUSTER_URI": {
        "type": "string",
        "defaultValue": ""
      },
      "EVENTHOUSE_DATABASE": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "annotations": [
      "AML",
      "SentinelMesh",
      "Layer9",
      "SelfLearning"
    ]
  }
}
