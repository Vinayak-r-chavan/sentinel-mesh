{
  "name": "SentinelMesh_Full_Orchestrator",
  "properties": {
    "description": "Master end-to-end cognitive AML data orchestration pipeline. Sequentially triggers Layers 3, 4, 6, and 7 to process streaming transactions, build behavioral DNA profiles, detect networks, score alerts, and draft SARs.",
    "activities": [
      {
        "name": "Run_Behavioral_DNA",
        "type": "Notebook",
        "dependsOn": [],
        "policy": { "timeout": "0.02:00:00", "retry": 1, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "notebook": { "referenceName": "L3_Behavioral_DNA", "type": "NotebookReference" },
          "parameters": {
            "EVENTHOUSE_CLUSTER_URI": { "value": "@pipeline().parameters.EVENTHOUSE_CLUSTER_URI", "type": "Expression" },
            "EVENTHOUSE_DATABASE": { "value": "@pipeline().parameters.EVENTHOUSE_DATABASE", "type": "Expression" }
          }
        }
      },
      {
        "name": "Run_Graph_Analysis",
        "type": "Notebook",
        "dependsOn": [
          {
            "activity": "Run_Behavioral_DNA",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": { "timeout": "0.02:00:00", "retry": 1, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "notebook": { "referenceName": "L4_Graph_Analysis", "type": "NotebookReference" },
          "parameters": {
            "EVENTHOUSE_CLUSTER_URI": { "value": "@pipeline().parameters.EVENTHOUSE_CLUSTER_URI", "type": "Expression" },
            "EVENTHOUSE_DATABASE": { "value": "@pipeline().parameters.EVENTHOUSE_DATABASE", "type": "Expression" }
          }
        }
      },
      {
        "name": "Run_Entity_Resolution",
        "type": "Notebook",
        "dependsOn": [
          {
            "activity": "Run_Graph_Analysis",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": { "timeout": "0.02:00:00", "retry": 1, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "notebook": { "referenceName": "Entity_Resolution", "type": "NotebookReference" },
          "parameters": {
            "EVENTHOUSE_CLUSTER_URI": { "value": "@pipeline().parameters.EVENTHOUSE_CLUSTER_URI", "type": "Expression" },
            "EVENTHOUSE_DATABASE": { "value": "@pipeline().parameters.EVENTHOUSE_DATABASE", "type": "Expression" }
          }
        }
      },
      {
        "name": "Generate_Risk_Alerts",
        "type": "KqlScript",
        "dependsOn": [
          {
            "activity": "Run_Entity_Resolution",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "script": ".set-or-append fact_alerts <| generate_composite_alerts()",
          "connection": {
            "clusterUri": "@pipeline().parameters.EVENTHOUSE_CLUSTER_URI",
            "database": "@pipeline().parameters.EVENTHOUSE_DATABASE"
          }
        }
      },
      {
        "name": "Run_SAR_Generator",
        "type": "Notebook",
        "dependsOn": [
          {
            "activity": "Generate_Risk_Alerts",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": { "timeout": "0.02:00:00", "retry": 1, "retryIntervalInSeconds": 30 },
        "typeProperties": {
          "notebook": { "referenceName": "L7_SAR_Generator", "type": "NotebookReference" },
          "parameters": {
            "EVENTHOUSE_CLUSTER_URI": { "value": "@pipeline().parameters.EVENTHOUSE_CLUSTER_URI", "type": "Expression" },
            "EVENTHOUSE_DATABASE": { "value": "@pipeline().parameters.EVENTHOUSE_DATABASE", "type": "Expression" }
          }
        }
      }
    ],
    "parameters": {
      "EVENTHOUSE_CLUSTER_URI": { "type": "string", "defaultValue": "" },
      "EVENTHOUSE_DATABASE": { "type": "string", "defaultValue": "" }
    }
  }
}
